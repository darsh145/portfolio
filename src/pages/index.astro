---
import Layout from '../layouts/Layout.astro';

// Page that shows a loader and redirects to the home page after a delay
---

<Layout>
	<div class="h-screen w-full flex flex-col items-center justify-center bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500">
		<div class="intro-txt">
			<p class="text-5xl font-bold text-center text-white font-reenie">Summoning Creativity...<br><br>it may take a while</p>
		</div>
	</div>
</Layout>

<script>
	// Redirect to home page after 3 seconds (3000 milliseconds)
	setTimeout(() => {
		window.location.href = '/home';
	}, 2000);
</script>

<style>
	/* Additional loader styles if needed */
	.loader {
		transform-origin: center;
	}
	.font-reenie {
        font-family: 'Reenie Beanie', cursive;
    }
</style>

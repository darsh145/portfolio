---
import Layout from '../layouts/Layout.astro';

// Page that shows a loader and redirects to the home page after a delay
---

<Layout>
	<div class="h-screen w-full flex items-center justify-center bg-white relative overflow-hidden">
		 <!-- Desktop version - Full screen onboard animation -->
		<div class="hidden md:block w-full h-full">
			<dotlottie-player 
				src="/animations/onboard-portfolio.json" 
				background="transparent" 
				speed="1" 
				style="width: 100%; height: 100%;" 
				loop 
				autoplay>
			</dotlottie-player>
		</div>
		
		<!-- Mobile version - Mobile optimized animation -->
		<div class="block md:hidden w-full h-full">
			<dotlottie-player 
				src="/animations/onboard-mobile-view.json" 
				background="transparent" 
				speed="1" 
				style="width: 100%; height: 100%;" 
				loop 
				autoplay>
			</dotlottie-player>
		</div>
	</div>
</Layout>

<script>
	setTimeout(() => {
		window.location.href = '/home';
	}, 2600);
</script>

<style>
	.font-reenie {
        font-family: 'Reenie Beanie', cursive;
    }
</style>

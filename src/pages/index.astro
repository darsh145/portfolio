---
import Layout from '../layouts/Layout.astro';

// Page that shows a loader and redirects to the home page after a delay
---

<Layout>
	<div class="h-screen w-full flex flex-col items-center justify-center bg-white relative overflow-hidden">
		<div class="relative w-full h-full flex flex-col items-center justify-center">
			<!-- Intro text with higher z-index -->
			<div class="intro-txt absolute z-20 top-[50%] transform -translate-y-1/2">
				<p class="text-5xl font-bold text-center text-black font-reenie">Summoning Creativity...<br><br>it may take a while</p>
			</div>
			
			<!-- Paperplane animation with movement -->
			<div class="paperplane-container absolute z-10 w-84 h-84">
				<dotlottie-player 
					src="/animations/paperplane.json" 
					background="transparent" 
					speed="0.8" 
					style="width: 100%; height: 100%;" 
					loop 
					autoplay>
				</dotlottie-player>
			</div>
		</div>
	</div>
</Layout>

<script>
	setTimeout(() => {
		window.location.href = '/home';
	}, 2000);
</script>

<style>
	.loader {
		transform-origin: center;
	}
	
	.font-reenie {
        font-family: 'Reenie Beanie', cursive;
    }
	
	.paperplane-container {
		/* Start position: center of screen */
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		
		/* Animation to move to top-right */
		animation: flyToTopRight 2s ease-in-out forwards;
	}
	
	@keyframes flyToTopRight {
		0% {
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%) rotate(0deg);
			opacity: 1;
		}
		100% {
			top: 0%;
			left: 100%;
			transform: translate(-50%, -50%) rotate(15deg);
			opacity: 0.8;
		}
	}
</style>

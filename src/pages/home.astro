---
import Layout from '../layouts/Layout.astro';
import DockWrapper from '../components/DockWrapper.jsx';
import Folder from '../components/folder.jsx';
import CircularText from '../components/CircularText.jsx';
---

<Layout>
	<main class="container mx-auto px-4 sm:px-6 md:px-8 py-4 sm:py-6 md:py-8 font-manrope relative min-h-screen">
		<!-- Circular Text positioned at top left -->
		<!-- <div class="fixed top-4 left-4 sm:top-6 sm:left-6 md:top-8 md:left-8 z-50">
			<CircularText 
				text="PRODUCT DESIGNER • UI/UX • " 
				spinDuration={15} 
				onHover="speedUp"
				className="w-20 h-20 sm:w-28 sm:h-28 md:w-36 md:h-36"
				client:only="react"
			/>
		</div> -->

		<!-- Additional landing page content will go here -->
		<div class="mt-4 sm:mt-6 md:mt-8">
			<h2 class="flex justify-center text-center text-2xl sm:text-3xl md:text-4xl font-bold text-gray-600 font-reenie transform rotate-[-8deg] px-4">Welcome to my corner<br>on the internet :)
            
            </h2>	
		</div>
        <!-- <div class="">
            <CircularText
                text="Darsh*Panchal*Design*"
                onHover="speedUp"
                spinDuration={20}
                className="custom-class"
            />
        </div> -->
        <div class="cent flex flex-col sm:flex-col md:flex-row justify-center items-center gap-6 sm:gap-8 md:gap-12 lg:gap-[6rem] min-h-[40vh] sm:min-h-[45vh] md:min-h-[50vh] w-full py-6 sm:py-8">
            <a href="/service" class="flex flex-col justify-center items-center no-underline">
                <div class="cursor-pointer">
                    <Folder size={1.2} sm:size={1.3} md:size={1.5} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
                </div>
                <p class="text-black mt-4 sm:mt-5 md:mt-6 font-reenie text-2xl sm:text-3xl md:text-4xl font-bold">Services</p>
            </a>
            <a href="/work" class="flex flex-col justify-center items-center no-underline">
                <div class="cursor-pointer">
                    <Folder size={1.2} sm:size={1.3} md:size={1.5} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
                </div>
                <p class="text-black mt-4 sm:mt-5 md:mt-6 font-reenie text-2xl sm:text-3xl md:text-4xl font-bold">Work Gallery</p>
            </a>
            <a href="/extras" class="flex flex-col justify-center items-center no-underline">
                <div class="cursor-pointer">
                    <Folder size={1.2} sm:size={1.3} md:size={1.5} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
                </div>
                <p class="text-black mt-4 sm:mt-5 md:mt-6 font-reenie text-2xl sm:text-3xl md:text-4xl font-bold">Miscellaneous</p>
            </a>
            <a href="/collaborate" class="flex flex-col justify-center items-center no-underline">
                <div class="cursor-pointer">
                    <Folder size={1.2} sm:size={1.3} md:size={1.5} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
                </div>
                <p class="text-black mt-4 sm:mt-5 md:mt-6 font-reenie text-2xl sm:text-3xl md:text-4xl font-bold">Let's Collab</p>
            </a>
            
        </div>
        <div class="flex justify-center items-center px-4 sm:px-6 md:px-8">
            <p class="flex justify-center text-center text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold text-gray-600 font-reenie w-full sm:w-[90%] md:w-[80%] lg:w-[50rem] max-w-4xl leading-relaxed">
                <!-- <img src="peeps-avatar.png" alt="" height="100" width="100" class=""> -->
                Hey there! I'm Darsh - a Product Designer with a burning desire to build cool stuff. Currently, I run tools for creativity, share awesome stories through my UX design, and collab with visionaries to bring even more ideas to life.
            </p>
        </div>
        <div class="cent flex justify-center items-center w-full mt-6 sm:mt-8">
            <DockWrapper client:only="react" />
        </div>
	</main>
</Layout>
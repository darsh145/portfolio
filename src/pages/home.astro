---
import Layout from '../layouts/Layout.astro';
import DockWrapper from '../components/DockWrapper.jsx';
import Folder from '../components/folder.jsx';
import CircularText from '../components/CircularText.jsx';
---

<Layout>
	<main class="h-screen flex flex-col container mx-auto px-4 sm:px-6 md:px-8 py-4 sm:py-6 md:py-8 font-manrope relative overflow-hidden">
		<!-- Welcome section - reduced spacing -->
		<div class="flex-shrink-0 mt-2 sm:mt-4">
			<h2 class="flex justify-center text-center text-xl sm:text-2xl md:text-3xl font-semibold text-gray-600 font-reenie transform rotate-[-8deg] px-4">
				Welcome to my corner<br>on the internet :)
			</h2>	
		</div>

		<!-- Main content area - perfectly centered -->
		<div class="flex-1 flex flex-col justify-center items-center min-h-0">
			<!-- Navigation folders - reduced spacing and size -->
			<div class="flex flex-col sm:flex-col md:flex-row justify-center items-center gap-4 sm:gap-6 md:gap-8 lg:gap-12 w-full mb-4 sm:mb-6">
				<a href="/service" class="flex flex-col justify-center items-center no-underline">
					<div class="cursor-none">
						<Folder size={1.0} sm:size={1.1} md:size={1.2} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
					</div>
					<p class="text-black mt-2 sm:mt-3 font-reenie text-xl sm:text-2xl md:text-3xl font-semibold cursor-none">Services</p>
				</a>
				<a href="/work" class="flex flex-col justify-center items-center no-underline">
					<div class="cursor-none">
						<Folder size={1.0} sm:size={1.1} md:size={1.2} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
					</div>
					<p class="text-black mt-2 sm:mt-3 font-reenie text-xl sm:text-2xl md:text-3xl font-semibold cursor-none">UI Designs</p>
				</a>
				<a href="/extras" class="flex flex-col justify-center items-center no-underline">
					<div class="cursor-none">
						<Folder size={1.0} sm:size={1.1} md:size={1.2} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
					</div>
					<p class="text-black mt-2 sm:mt-3 font-reenie text-xl sm:text-2xl md:text-3xl font-semibold cursor-none">Project Work</p>
				</a>
				<a href="/collaborate" class="flex flex-col justify-center items-center no-underline">
					<div class="cursor-none">
						<Folder size={1.0} sm:size={1.1} md:size={1.2} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
					</div>
					<p class="text-black mt-2 sm:mt-3 font-reenie text-xl sm:text-2xl md:text-3xl font-semibold cursor-none">Let's Collab</p>
				</a>
			</div>

			<!-- Description text - reduced size and spacing -->
			<div class="flex justify-center items-center px-4 sm:px-6 md:px-8">
				<p class="flex justify-center text-center text-sm sm:text-base md:text-lg lg:text-2xl font-semibold text-gray-600 font-reenie w-full sm:w-[90%] md:w-[80%] lg:w-[45rem] max-w-3xl leading-relaxed">
					Hey there! I'm Darsh - a Product Designer with a burning desire to build cool stuff. Currently, I run tools for creativity, share awesome stories through my UX design, and collab with visionaries to bring even more ideas to life.
				</p>
			</div>
		</div>

		<!-- Dock at bottom - absolutely positioned -->
		<div class="absolute bottom-2 sm:bottom-4 left-1/2 transform -translate-x-1/2 z-50 p-2 sm:p-4">
			<DockWrapper client:only="react" />
		</div>
	</main>
</Layout>

<style>
    .font-reenie {
        font-family: 'Reenie Beanie', cursive;
    }

    /* Ensure main container has proper spacing for dock */
    main {
        padding-bottom: 120px; /* Increased space for dock on mobile */
    }

    /* Make sure folders are touchable and properly spaced */
    .flex.flex-col.sm\\:flex-col.md\\:flex-row {
        gap: 1rem;
        padding: 0 1rem;
        margin-bottom: 2rem; /* Extra margin to prevent overlap */
    }

    /* Ensure all folder links are touchable */
    a[href="/collaborate"],
    a[href="/service"],
    a[href="/work"],
    a[href="/extras"] {
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        padding: 0.5rem;
        min-height: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 10; /* Ensure folders are above other elements */
    }

    /* Active state for touch feedback */
    a[href="/collaborate"]:active,
    a[href="/service"]:active,
    a[href="/work"]:active,
    a[href="/extras"]:active {
        transform: scale(0.95);
        opacity: 0.8;
    }

    /* Ensure dock doesn't overlap folders */
    .absolute.bottom-4 {
        position: fixed !important;
        bottom: 1rem !important;
        z-index: 50;
    }

    /* Responsive adjustments */
    @media (max-width: 640px) {
        main {
            padding-bottom: 140px; /* More space on small screens */
        }

        .flex.flex-col.sm\\:flex-col.md\\:flex-row {
            gap: 0.75rem;
        }
        
        /* Ensure last folder (Let's Collab) has enough space */
        a[href="/collaborate"] {
            margin-bottom: 1rem;
        }
    }

    @media (min-width: 641px) and (max-width: 768px) {
        main {
            padding-bottom: 100px;
        }
    }

    @media (min-width: 769px) {
        main {
            padding-bottom: 80px;
        }
    }

    /* Very small screens */
    @media (max-height: 600px) {
        main {
            padding-bottom: 160px;
        }
    }
</style>
---
import Layout from '../layouts/Layout.astro';
import DockWrapper from '../components/DockWrapper.jsx';
import Folder from '../components/folder.jsx';
import CircularText from '../components/CircularText.jsx';
---

<Layout>
	<main class="h-screen flex flex-col container mx-auto px-4 sm:px-6 md:px-8 py-4 sm:py-6 md:py-8 font-manrope relative overflow-hidden">
		<!-- Welcome section - reduced spacing -->
		<div class="flex-shrink-0 mt-2 sm:mt-4">
			<h2 class="flex justify-center text-center text-xl sm:text-2xl md:text-3xl font-bold text-gray-600 font-reenie transform rotate-[-8deg] px-4">
				Welcome to my corner<br>on the internet :)
			</h2>	
		</div>

		<!-- Main content area - perfectly centered -->
		<div class="flex-1 flex flex-col justify-center items-center min-h-0">
			<!-- Navigation folders - reduced spacing and size -->
			<div class="flex flex-col sm:flex-col md:flex-row justify-center items-center gap-4 sm:gap-6 md:gap-8 lg:gap-12 w-full mb-4 sm:mb-6">
				<a href="/service" class="flex flex-col justify-center items-center no-underline">
					<div class="cursor-pointer">
						<Folder size={1.0} sm:size={1.1} md:size={1.2} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
					</div>
					<p class="text-black mt-2 sm:mt-3 font-reenie text-xl sm:text-2xl md:text-3xl font-bold">Services</p>
				</a>
				<a href="/work" class="flex flex-col justify-center items-center no-underline">
					<div class="cursor-pointer">
						<Folder size={1.0} sm:size={1.1} md:size={1.2} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
					</div>
					<p class="text-black mt-2 sm:mt-3 font-reenie text-xl sm:text-2xl md:text-3xl font-bold">Work Gallery</p>
				</a>
				<a href="/extras" class="flex flex-col justify-center items-center no-underline">
					<div class="cursor-pointer">
						<Folder size={1.0} sm:size={1.1} md:size={1.2} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
					</div>
					<p class="text-black mt-2 sm:mt-3 font-reenie text-xl sm:text-2xl md:text-3xl font-bold">Miscellaneous</p>
				</a>
				<a href="/collaborate" class="flex flex-col justify-center items-center no-underline">
					<div class="cursor-pointer">
						<Folder size={1.0} sm:size={1.1} md:size={1.2} color="#00d8ff" className="custom-folder hover:scale-105 transition-transform"/>
					</div>
					<p class="text-black mt-2 sm:mt-3 font-reenie text-xl sm:text-2xl md:text-3xl font-bold">Let's Collab</p>
				</a>
			</div>

			<!-- Description text - reduced size and spacing -->
			<div class="flex justify-center items-center px-4 sm:px-6 md:px-8">
				<p class="flex justify-center text-center text-sm sm:text-base md:text-lg lg:text-2xl font-bold text-gray-600 font-reenie w-full sm:w-[90%] md:w-[80%] lg:w-[45rem] max-w-3xl leading-relaxed">
					Hey there! I'm Darsh - a Product Designer with a burning desire to build cool stuff. Currently, I run tools for creativity, share awesome stories through my UX design, and collab with visionaries to bring even more ideas to life.
				</p>
			</div>
		</div>

		<!-- Dock at bottom - absolutely positioned -->
		<div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 z-50">
			<DockWrapper client:only="react" />
		</div>
	</main>
</Layout>
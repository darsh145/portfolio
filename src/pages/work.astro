---
import Layout from "../layouts/Layout.astro"
import CardSwap from "@/components/CardSwap"
import { Card } from "@/components/CardSwap"
---

<Layout>
    <main class="container mx-auto px-4 sm:px-6 md:px-8 py-4 sm:py-6 md:py-8">
        <div class="mb-4 sm:mb-6">
            <a href="/home" class="inline-flex items-center px-2 py-2 bg-gray-200 hover:bg-[#00bbff40] text-white rounded-[50%] transition-colors duration-200 back-button cursor-none">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" height="20" width="20" sm:height="24" sm:width="24" fill="#000000">
                    <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
                </svg>
            </a>
        </div>

        <div class="mt-4 sm:mt-6 md:mt-8">
            <h2 class="flex justify-center text-center text-2xl sm:text-3xl md:text-4xl font-bold text-gray-700 font-reenie px-4">
                You Dream It. I Design It. You Take All the Credit !!
            </h2>	
        </div>

        <!-- Single Column Portfolio Projects -->
        <div class="mt-8 sm:mt-12 md:mt-16 flex flex-col gap-6 sm:gap-8 md:gap-12 max-w-6xl mx-auto">

            <!-- X screen redeisgn -->
            <div class="projectone flex flex-col lg:flex-row gap-6 sm:gap-8 lg:gap-10 rounded-2xl sm:rounded-3xl overflow-hidden group bento-item p-4 sm:p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full lg:w-1/2 h-48 sm:h-64 lg:h-80 relative overflow-hidden rounded-lg flex items-center justify-center">
                    <div class="w-full h-full flex items-center justify-center object-contain">
                        <img 
                            src="/redesignoldX.jpg">
                        </img>
                    </div>
                    <div class="w-full h-full flex items-center justify-center">
                        <dotlottie-player 
                            src="/animations/My_Goals-1.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                    </div>
                    
                </div>
                <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-800">A Quick Makeover for a Goals Screen</h3>
                    <p class="text-sm sm:text-base text-gray-800 leading-relaxed">Saw someone on X asking for a modern redesign of their “My Goals” screen… and I jumped in. No brief, no pressure just pure design joy. Quick, clean, and refreshing.
                    </p>
                    <div class="flex gap-4">
                        <a href="https://www.figma.com/design/djyFQPDmNcYkV7LbUzJMqC/practice?node-id=193-108&t=k6OhMASXKXtpBBs8-1" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                            Figma
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="https://jitter.video/file/?id=sMy0SFJzG2ZW3thz7Evn5lr6&nodeId=GxC-5kdAqF_w8zSY1bXsj&source=share_button" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                       Jitter
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- landing page task -->
            <div class="projectone flex flex-col lg:flex-row gap-6 sm:gap-8 lg:gap-10 rounded-2xl sm:rounded-3xl overflow-hidden group bento-item p-4 sm:p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full lg:w-1/2 h-48 sm:h-64 lg:h-80 relative overflow-hidden rounded-lg flex items-center justify-center">
                    <div class="w-full h-full flex items-center justify-center">
                        <dotlottie-player 
                            src="/animations/firstgenweb.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-800">A Visual First Impression</h3>
                    <p class="text-sm sm:text-base text-gray-800 leading-relaxed">Applied for a design role and thought, “Why not show them what I can actually do?” So I redesigned their landing page just for fun and sent it along with my application. A little extra effort never hurts — and this one was surprisingly fun.
                    </p>
                    <div class="flex gap-4">
                        <a href="https://www.figma.com/design/djyFQPDmNcYkV7LbUzJMqC/practice?node-id=201-127&t=k6OhMASXKXtpBBs8-1" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                            Figma
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="https://jitter.video/file/?id=sMy0SFJzG2ZW3thz7Evn5lr6&nodeId=HPuP6S_HMd0GBUql6dISv&source=share_button" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                       Jitter
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- landing page car -->
            <div class="projectone flex flex-col lg:flex-row gap-6 sm:gap-8 lg:gap-10 rounded-2xl sm:rounded-3xl overflow-hidden group bento-item p-4 sm:p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full lg:w-1/2 h-48 sm:h-64 lg:h-80 relative overflow-hidden rounded-lg flex items-center justify-center">
                    <div class="w-full h-full flex items-center justify-center">
                        <dotlottie-player 
                            src="/animations/car-landing-page.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-800">EV charging finder platform</h3>
                    <p class="text-sm sm:text-base text-gray-800 leading-relaxed">Built this one to shake off some boredom and procrastination turned out pretty fun to work on!
                    Focus was on simplicity, quick search flow, and a modern layout for EV users on the go.
                    </p>
                    <div class="flex gap-4">
                        <a href="https://www.figma.com/design/djyFQPDmNcYkV7LbUzJMqC/practice?node-id=116-87&t=ZGjDq4FV12gpl5RJ-1" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                            Figma
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="https://jitter.video/file/?id=sMy0SFJzG2ZW3thz7Evn5lr6&nodeId=k5PaUordR4aEFtZbDiJ_n&source=share_button" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                       Jitter
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                        </a>
                    </div>
                </div>
            </div>

             <!-- Dashboard -->
            <div class="projectone flex flex-col lg:flex-row gap-6 sm:gap-8 lg:gap-10 rounded-2xl sm:rounded-3xl overflow-hidden group bento-item p-4 sm:p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full lg:w-1/2 h-48 sm:h-64 lg:h-80 relative overflow-hidden rounded-lg flex items-center justify-center">
                    <div class="w-full h-full flex items-center justify-center">
                        <dotlottie-player 
                            src="/animations/Dashboard.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-800">The Dashboard I Needed</h3>
                    <p class="text-sm sm:text-base text-gray-800 leading-relaxed">I came across a clean dashboard design on X and couldn’t resist recreating it from scratch, partly to understand its flow, partly because I needed more dashboards in my design closet. It started as a reference, but somewhere along the way, I made it mine! balanced, structured, and quietly confident.</p>
                    <div class="flex gap-4">
                        <a href="https://www.figma.com/design/djyFQPDmNcYkV7LbUzJMqC/practice?node-id=116-87&t=ZGjDq4FV12gpl5RJ-1" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                            Figma
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="https://jitter.video/file/?id=sMy0SFJzG2ZW3thz7Evn5lr6&nodeId=k5PaUordR4aEFtZbDiJ_n&source=share_button" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                       Jitter
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Project 1 (bento display) -->
            <div class="projectone flex flex-col lg:flex-row gap-6 sm:gap-8 lg:gap-10 rounded-2xl sm:rounded-3xl overflow-hidden group bento-item p-4 sm:p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full lg:w-1/2 h-48 sm:h-64 lg:h-80 relative overflow-hidden rounded-lg flex items-center justify-center">
                    <div class="w-full h-full flex items-center justify-center">
                        <dotlottie-player 
                            src="/animations/Bento-Display.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-800">The White Mess That Taught Me Spacing</h3>
                    <p class="text-sm sm:text-base text-gray-800 leading-relaxed">This dashboard started with nothing but curiosity. I stumbled upon an all-white layout and thought, why not try it? Soon, I found myself drowning in white-on-white components and random bento cards that didn’t even make sense together. But that chaos taught me a lot, how to handle spacing, layering, and subtle shade variations when everything looks the same. It’s not perfect, but it’s the one that made me obsessed with balance.</p>
                    <div class="flex gap-4">
                        <a href="https://www.figma.com/design/djyFQPDmNcYkV7LbUzJMqC/practice?node-id=62-68&t=vphRBnQZiqMoA7aR-1" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                            Figma
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="https://jitter.video/file/?id=sMy0SFJzG2ZW3thz7Evn5lr6&nodeId=ama7YjEwTL-rRpBbgVW_7&source=share_button" class="inline-flex items-center px-3 sm:px-4 py-2 bg-gray-200 hover:bg-gray-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                       Jitter
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Project 2 (payment cards) -->
            <div class="projectone flex flex-col lg:flex-row gap-6 sm:gap-8 lg:gap-10 rounded-2xl sm:rounded-3xl overflow-hidden group bento-item p-4 sm:p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full lg:w-1/2 h-48 sm:h-64 lg:h-80 relative overflow-hidden rounded-lg flex items-center justify-center">
                    <div class="w-full h-full flex items-center justify-center">
                        <dotlottie-player 
                            src="/animations/Payment-confirm (1).json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                        <dotlottie-player 
                            src="/animations/Payment-processing.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                        <dotlottie-player 
                            src="/animations/Review-&-pay.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-800">Swipe, Wait, Done.</h3>
                    <p class="text-sm sm:text-base text-gray-800 leading-relaxed">This one came out of a random scroll session. I saw a sleek payment flow and thought, I could make that move. So I did. Three screens: review, processing, confirmation. Simple on paper, but for me, it was all about the micro stuff, the tiny motions, the subtle animations that make you feel the flow. I built it just to play, to see how much personality I could pack into those few seconds of transition.</p>
                    <div class="flex gap-4">
                        <a href="https://www.figma.com/design/djyFQPDmNcYkV7LbUzJMqC/practice?node-id=1-2&t=vphRBnQZiqMoA7aR-1" class="inline-flex items-center px-3 sm:px-4 py-2 bg-orange-200 hover:bg-orange-300 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                            Figma
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="https://jitter.video/file/?id=sMy0SFJzG2ZW3thz7Evn5lr6&source=share_button" class="inline-flex items-center px-3 sm:px-4 py-2 bg-orange-200 hover:bg-orange-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                       Jitter
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Project 3 (notes) -->
            <div class="projectone flex flex-col lg:flex-row gap-6 sm:gap-8 lg:gap-10 rounded-2xl sm:rounded-3xl overflow-hidden group bento-item p-4 sm:p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full lg:w-1/2 h-48 sm:h-64 lg:h-80 relative overflow-hidden rounded-lg flex items-center justify-center">
                    <div class="w-full h-full flex items-center justify-center">
                        <dotlottie-player 
                            src="/animations/notes.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-800">The Random One Everyone Liked</h3>
                    <p class="text-sm sm:text-base text-gray-800 leading-relaxed">I wasn’t planning this at all, just saw a notes app concept and thought, looks fun, let’s make it. No big idea, no goal, just a random spark that turned into an onboarding flow. Funny thing? This one got the most love. Guess sometimes the things you do without overthinking end up hitting right.</p>
                    <div class="flex gap-4">
                        <a href="https://www.figma.com/design/djyFQPDmNcYkV7LbUzJMqC/practice?node-id=16-131&t=vphRBnQZiqMoA7aR-1" class="inline-flex items-center px-3 sm:px-4 py-2 bg-purple-200 hover:bg-purple-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                            Figma
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="https://jitter.video/file/?id=sMy0SFJzG2ZW3thz7Evn5lr6&source=share_button" class="inline-flex items-center px-3 sm:px-4 py-2 bg-purple-200 hover:bg-purple-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                       Jitter
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Project 4 (nutrition-plans) -->
            <div class="projectone flex flex-col lg:flex-row gap-6 sm:gap-8 lg:gap-10 rounded-2xl sm:rounded-3xl overflow-hidden group bento-item p-4 sm:p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full lg:w-1/2 h-48 sm:h-64 lg:h-80 relative overflow-hidden rounded-lg flex items-center justify-center">
                    <div class="w-full h-full flex items-center justify-center">
                        <dotlottie-player 
                            src="/animations/nutrition-plans.json" 
                            background="transparent" 
                            speed="1" 
                            style="width: 100%; height: 100%;" 
                            loop 
                            autoplay>
                        </dotlottie-player>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-800">The Prove-It Screen</h3>
                    <p class="text-sm sm:text-base text-gray-800 leading-relaxed">Someone once said pulling off minimal gradients is tricky. I took that personally. So I designed this nutrition app onboarding just to prove I could make something clean, sleek, and subtle without breaking a sweat. No overdone colors, no clutter just quiet confidence in pixels.</p>

                    <div class="flex gap-4">
                        <a href="https://www.figma.com/design/djyFQPDmNcYkV7LbUzJMqC/practice?node-id=1-257&t=vphRBnQZiqMoA7aR-1" class="inline-flex items-center px-3 sm:px-4 py-2 bg-orange-200 hover:bg-orange-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">
                            Figma
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="https://jitter.video/file/?id=sMy0SFJzG2ZW3thz7Evn5lr6&source=share_button" class="inline-flex items-center px-3 sm:px-4 py-2 bg-orange-200 hover:bg-orange-400 text-black rounded-lg transition-colors duration-200 max-w-max text-sm sm:text-base cursor-none">

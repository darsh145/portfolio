---
import Layout from "../layouts/Layout.astro"
---

<Layout>
    <main class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="/home" class="inline-flex items-center px-2 py-2 bg-gray-200 hover:bg-gray-300 text-white rounded-[50%] transition-colors duration-200 back-button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" height="24" width="24" fill="#000000">
                    <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
                </svg>
            </a>
        </div>

        <div class="mt-8">
            <h2 class="flex justify-center text-center text-4xl font-bold text-gray-600 font-reenie">
                You Dream It. I Design It. You Take All the Credit !!
            </h2>	
        </div>

        <!-- Single Column Portfolio Projects -->
        <div class="mt-16 flex flex-col gap-12 max-w-6xl mx-auto">
            <!-- Project 1 -->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/chime.png" alt="UI/UX Design System" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Chime Music App</h3>
                    <p class="text-gray-600 mb-6">Chime delivers a seamless music experience across desktop and mobile with bold visuals, personalized playlists, and a clean, immersive UI that keeps the vibe alive wherever you go.</p>
                    <a href="https://www.behance.net/gallery/225629481/Chime-Music-UI-Design" class="inline-flex items-center px-4 py-2 bg-red-200 hover:bg-red-300 text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Project 2 -->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/coinview.png" alt="Coinview Project" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Coinview</h3>
                    <p class="text-gray-600 mb-6">A cryptocurrency dashboard designed to track market movements and portfolio performance with intuitive analytics.</p>
                    <a href="https://www.behance.net/gallery/222545783/CoinView-A-Finance-Dashboard-for-Crypto-Investors" class="inline-flex items-center px-4 py-2 bg-blue-200 hover:bg-blue-300 text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>

            <!--Resido-->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/resido.png" alt="UI/UX Design System" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Resido UX</h3>
                    <p class="text-gray-600 mb-6">Designed platform MVP for Resido, a home services platform offering repairs, cleaning, installations, and more—focused on intuitive UX, fast bookings, and seamless user flow across web and app.</p>
                    <a href="https://www.behance.net/gallery/222801375/RESIDO-UX-Study-Product-Design" class="inline-flex items-center px-4 py-2 bg-[#0078FF50] hover:bg-[#0078FF80] text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Project 3 -->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/watchui.png" alt="WatchUI Project" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">WatchUI</h3>
                    <p class="text-gray-600 mb-6">A smartwatch interface design with a focus on minimalism and usability for health and fitness tracking.</p>
                    <a href="https://www.behance.net/gallery/221988817/Watch-OS-UI" class="inline-flex items-center px-4 py-2 bg-orange-200 hover:bg-orange-300 text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Project 4 -->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/liveasy.png" alt="Liveasy Project" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Liveasy</h3>
                    <p class="text-gray-600 mb-6">Redesigned the MVP for Liveasy.com, streamlining logistics management through a unified, user-first platform optimized for automation, visibility, and operational efficiency.</p>
                    <a href="https://www.figma.com/design/LDb5KkE4z36mpC2IX9UgaP/liveasy_task--Copy-?node-id=0-1&t=5cJYBgYm7r5gSqt6-1" class="inline-flex items-center px-4 py-2 bg-blue-200 hover:bg-blue-300 text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Project 5 -->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/taskly.png" alt="Taskly Project" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Taskly</h3>
                    <p class="text-gray-600 mb-6">A productivity app with intuitive task management features, calendar integration, and progress tracking.</p>
                    <a href="https://www.behance.net/gallery/222037437/task-manager-mobile-ui" class="inline-flex items-center px-4 py-2 bg-gray-200 hover:bg-gray-300 text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Project 6 -->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/expense-watchui.png" alt="Expense Tracker" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Expense Tracker</h3>
                    <p class="text-gray-600 mb-6">A sleek, intuitive watch UI that turns financial tracking into a real-time, on-wrist experience with monitor balances, manage spendings, and crush savings goals effortlessly.</p>
                    <a href="https://www.behance.net/gallery/219948859/Watch-UI" class="inline-flex items-center px-4 py-2 bg-purple-200 hover:bg-purple-300 text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Project 7 -->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/verdor.png" alt="Verdor Project" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Verdor</h3>
                    <p class="text-gray-600 mb-6">A Plant care platform designed for sustainable and eco-friendly caring for your green buddies with ethical sourcing information.</p>
                    <div class="flex gap-4">
                    <a href="https://www.behance.net/gallery/225196511/Verdor-Plant-App" class="inline-flex items-center px-4 py-2 bg-green-200 hover:bg-green-300 text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                    <a href="https://www.figma.com/design/AukK49AqGuGDBK8LBjxro7/Verdor---Plant-Care-App?node-id=18-3008&t=dl2yAdlabl46y4Zm-1" class="inline-flex items-center px-4 py-2 bg-green-200 hover:bg-green-300 text-black rounded-lg transition-colors duration-200 max-w-max">
                        Figma
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                    </div>
                </div>
            </div>

            <!-- Project 8 -->
            <div class="flex flex-col md:flex-row gap-6 rounded-3xl overflow-hidden group bento-item p-6 bg-gray-50 shadow-sm transition-all duration-300">
                <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
                    <img src="./projects/fallout.png" alt="Fallout Project" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                </div>
                <div class="w-full md:w-1/2 flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Fallout Clothing</h3>
                    <p class="text-gray-600 mb-6">Fallout blends pixel nostalgia with bold minimalism and redefining streetwear shopping through an interactive, style-first digital storefront made for the trendsetters.</p>
                    <a href="https://www.behance.net/gallery/219239721/Fallout-Project" class="inline-flex items-center px-4 py-2 bg-[#00bbff40] hover:bg-[#00bbff80] text-black rounded-lg transition-colors duration-200 max-w-max">
                        View Project
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .font-reenie {
        font-family: 'Reenie Beanie', cursive;
    }

    .bento-item {
        transition: all 0.3s ease;
    }

    .bento-item:hover {
        transform: translateY(-5px);
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .bento-item {
            flex-direction: column;
        }
        .bento-item > div:first-child {
            margin-bottom: 1rem;
        }
    }
</style>
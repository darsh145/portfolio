---
import Layout from "../layouts/Layout.astro"
---

<Layout>
    <main class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="/home" class="inline-flex items-center px-2 py-2 bg-gray-200 hover:bg-gray-300 text-white rounded-[50%] transition-colors duration-200 back-button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" height="24" width="24" fill="#000000">
                    <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
                </svg>
            </a>
        </div>

        <div class="mt-8">
            <h2 class="flex justify-center text-center text-4xl font-bold text-gray-600 font-reenie">
                I Design. I Build. I Pretend it's easy !!
            </h2>	
        </div>
        
        <!-- Rest of the bento grid -->
        <div class="mt-16 grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <div class="bg-[#FF9E80] rounded-[12px] p-6 min-h-[320px] flex flex-col sticky-note sticky-note-orange relative shadow-lg">
                <div class="flex flex-col h-full">
                    <img src="/blackpin.png" alt="Pin" class="pin-image" />
                    <div class="logo-container relative mb-4">
                        
                        <div class="w-14 h-14 bg-black flex items-center justify-center overflow relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="24" height="24" fill="#ffffff"><path d="M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.2-2.7 15.7-7.4 21.9-13.5L437.7 172.3 339.7 74.3 172.4 241.7zM96 64C43 64 0 107 0 160L0 416c0 53 43 96 96 96l256 0c53 0 96-43 96-96l0-96c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 96c0 17.7-14.3 32-32 32L96 448c-17.7 0-32-14.3-32-32l0-256c0-17.7 14.3-32 32-32l96 0c17.7 0 32-14.3 32-32s-14.3-32-32-32L96 64z"/></svg>
                        </div>
                    </div>
                    <div class="text-left flex-grow">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">UI/UX Design</h3>
                        <p class="text-gray-700 font-reenie text-2xl font-bold">
                            Designs that don't just look good — they feel right.
                            I create intuitive interfaces and smooth user journeys that make users stay, explore, and engage.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-[#80D8FF] rounded-[12px] p-6 min-h-[320px] flex flex-col sticky-note sticky-note-blue relative shadow-lg">
                <div class="flex flex-col h-full">
                    <img src="/blackpin.png" alt="Pin" class="pin-image" />
                    <div class="logo-container relative mb-4">
                        
                        <div class="w-14 h-14 bg-black flex items-center justify-center overflow-hidden relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" width="24" height="24" fill="#ffffff"><path d="M80 0C44.7 0 16 28.7 16 64l0 384c0 35.3 28.7 64 64 64l224 0c35.3 0 64-28.7 64-64l0-384c0-35.3-28.7-64-64-64L80 0zm80 432l64 0c8.8 0 16 7.2 16 16s-7.2 16-16 16l-64 0c-8.8 0-16-7.2-16-16s7.2-16 16-16z"/></svg>
                        </div>
                    </div>
                    <div class="text-left flex-grow">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">Application Design</h3>
                        <p class="text-gray-700 font-reenie text-2xl font-bold">
                            Designing apps users don’t uninstall.
                            From flow to finesse — I design mobile and desktop apps that are functional, delightful, and totally thumb-friendly.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-[#B388FF] rounded-[12px] p-6 min-h-[320px] flex flex-col sticky-note sticky-note-purple relative shadow-lg">
                <div class="flex flex-col h-full">
                    <img src="/blackpin.png" alt="Pin" class="pin-image" />
                    <div class="logo-container relative mb-4">
                        
                        <div class="w-14 h-14 bg-black flex items-center justify-center overflow-hidden relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="24" height="24" fill="#ffffff"><path d="M64 0C28.7 0 0 28.7 0 64L0 352c0 35.3 28.7 64 64 64l176 0-10.7 32L160 448c-17.7 0-32 14.3-32 32s14.3 32 32 32l256 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-69.3 0L336 416l176 0c35.3 0 64-28.7 64-64l0-288c0-35.3-28.7-64-64-64L64 0zM512 64l0 288L64 352 64 64l448 0z"/></svg>
                        </div>
                    </div>
                    <div class="text-left flex-grow">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">Website Design</h3>
                        <p class="text-gray-700 font-reenie text-2xl font-bold">
                            Where beauty meets usability (and loads fast).
                            I craft websites that are visually stunning, responsive across devices, and aligned with your brand’s voice.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-[#84FFFF] rounded-[12px] p-6 min-h-[320px] flex flex-col sticky-note sticky-note-teal relative shadow-lg">
                <div class="flex flex-col h-full">
                    <img src="/blackpin.png" alt="Pin" class="pin-image" />
                    <div class="logo-container relative mb-4">
                        
                        <div class="w-14 h-14 bg-black flex items-center justify-center overflow-hidden relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="24" height="24" fill="#ffffff"><path d="M512 256c0 .9 0 1.8 0 2.7c-.4 36.5-33.6 61.3-70.1 61.3L344 320c-26.5 0-48 21.5-48 48c0 3.4 .4 6.7 1 9.9c2.1 10.2 6.5 20 10.8 29.9c6.1 13.8 12.1 27.5 12.1 42c0 31.8-21.6 60.7-53.4 62c-3.5 .1-7 .2-10.6 .2C114.6 512 0 397.4 0 256S114.6 0 256 0S512 114.6 512 256zM128 288a32 32 0 1 0 -64 0 32 32 0 1 0 64 0zm0-96a32 32 0 1 0 0-64 32 32 0 1 0 0 64zM288 96a32 32 0 1 0 -64 0 32 32 0 1 0 64 0zm96 96a32 32 0 1 0 0-64 32 32 0 1 0 0 64z"/></svg>
                        </div>
                    </div>
                    <div class="text-left flex-grow">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">UI Design</h3>
                        <p class="text-gray-700 font-reenie text-2xl font-bold">
                            Polished pixels. Seamless interactions.
                            I focus on creating visually clean and consistent interfaces that elevate the user experience.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-[#B9F6CA] rounded-[12px] p-6 min-h-[320px] flex flex-col sticky-note sticky-note-green relative shadow-lg">
                <div class="flex flex-col h-full">
                    <img src="/blackpin.png" alt="Pin" class="pin-image" />
                    <div class="logo-container relative mb-4">
                        
                        <div class="w-14 h-14 bg-black flex items-center justify-center overflow-hidden relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="24" height="24" fill="#ffffff"><path d="M469.2 75A75.6 75.6 0 1 0 317.9 75a75.6 75.6 0 1 0 151.2 0zM154.2 240.7A75.6 75.6 0 1 0 3 240.7a75.6 75.6 0 1 0 151.2 0zM57 346C75.6 392.9 108 433 150 461.1s91.5 42.6 142 41.7c-14.7-18.6-22.9-41.5-23.2-65.2c-6.8-.9-13.3-2.1-19.5-3.4c-26.8-5.7-51.9-17.3-73.6-34s-39.3-38.1-51.7-62.5c-20.9 9.9-44.5 12.8-67.1 8.2zm395.1 89.8a75.6 75.6 0 1 0 -151.2 0 75.6 75.6 0 1 0 151.2 0zM444 351.6c18.5 14.8 31.6 35.2 37.2 58.2c33.3-41.3 52.6-92.2 54.8-145.2s-12.5-105.4-42.2-149.4c-8.6 21.5-24 39.6-43.8 51.6c15.4 28.6 22.9 60.8 21.9 93.2s-10.7 64-28 91.6zM101.1 135.4c12.4 2.7 24.3 7.5 35.1 14.3c16.6-24.2 38.9-44.1 64.8-58S255.8 70.4 285.2 70c.2-5.9 .9-11.9 2-17.7c3.6-16.7 11.1-32.3 21.8-45.5c-47.7-3.8-95.4 6-137.6 28.5S94.3 91.7 70.8 133.4c2.7-.2 5.3-.3 8-.3c7.5 0 15 .8 22.4 2.3z"/></svg>
                        </div>
                    </div>
                    <div class="text-left flex-grow">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">Design System</h3>
                        <p class="text-gray-700 font-reenie text-2xl font-bold">
                            One system to style them all.
                            I build scalable and reusable design systems — from components to tokens — so your product stays consistent, no matter who touches it.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-[#FFCC80] rounded-[12px] p-6 min-h-[320px] flex flex-col sticky-note sticky-note-orange-light relative shadow-lg">
                <div class="flex flex-col h-full">
                    <img src="/blackpin.png" alt="Pin" class="pin-image" />
                    <div class="logo-container relative mb-4">
                        
                        <div class="w-14 h-14 bg-black flex items-center justify-center overflow-hidden relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="24" height="24" fill="#ffffff">
                                <path d="M128 32c0-17.7-14.3-32-32-32S64 14.3 64 32l0 32L32 64C14.3 64 0 78.3 0 96s14.3 32 32 32l32 0 0 256c0 35.3 28.7 64 64 64l224 0 0-64-224 0 0-352zM384 480c0 17.7 14.3 32 32 32s32-14.3 32-32l0-32 32 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-32 0 0-256c0-35.3-28.7-64-64-64L160 64l0 64 224 0 0 352z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="text-left flex-grow">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">Wireframing</h3>
                        <p class="text-gray-700 font-reenie text-2xl font-bold">
                            Blueprints that make sense (before the sparkle).
                            I sketch out smart layouts and flows to map the user journey clearly, before jumping into the aesthetics.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-[#EA80FC] rounded-[12px] p-6 min-h-[320px] flex flex-col sticky-note sticky-note-pink relative shadow-lg">
                <div class="flex flex-col h-full">
                    <img src="/blackpin.png" alt="Pin" class="pin-image" />
                    <div class="logo-container relative mb-4">
                        
                        <div class="w-14 h-14 bg-black flex items-center justify-center overflow-hidden relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="24" height="24" fill="#ffffff"><path d="M352 256c0 22.2-1.2 43.6-3.3 64l-185.3 0c-2.2-20.4-3.3-41.8-3.3-64s1.2-43.6 3.3-64l185.3 0c2.2 20.4 3.3 41.8 3.3 64zm28.8-64l123.1 0c5.3 20.5 8.1 41.9 8.1 64s-2.8 43.5-8.1 64l-123.1 0c2.1-20.6 3.2-42 3.2-64s-1.1-43.4-3.2-64zm112.6-32l-116.7 0c-10-63.9-29.8-117.4-55.3-151.6c78.3 20.7 142 77.5 171.9 151.6zm-149.1 0l-176.6 0c6.1-36.4 15.5-68.6 27-94.7c10.5-23.6 22.2-40.7 33.5-51.5C239.4 3.2 248.7 0 256 0s16.6 3.2 27.8 13.8c11.3 10.8 23 27.9 33.5 51.5c11.6 26 20.9 58.2 27 94.7zm-209 0L18.6 160C48.6 85.9 112.2 29.1 190.6 8.4C165.1 42.6 145.3 96.1 135.3 160zM8.1 192l123.1 0c-2.1 20.6-3.2 42-3.2 64s1.1 43.4 3.2 64L8.1 320C2.8 299.5 0 278.1 0 256s2.8-43.5 8.1-64zM194.7 446.6c-11.6-26-20.9-58.2-27-94.6l176.6 0c-6.1 36.4-15.5 68.6-27 94.6c-10.5 23.6-22.2 40.7-33.5 51.5C272.6 508.8 263.3 512 256 512s-16.6-3.2-27.8-13.8c-11.3-10.8-23-27.9-33.5-51.5zM135.3 352c10 63.9 29.8 117.4 55.3 151.6C112.2 482.9 48.6 426.1 18.6 352l116.7 0zm358.1 0c-30 74.1-93.6 130.9-171.9 151.6c25.5-34.2 45.2-87.7 55.3-151.6l116.7 0z"/></svg>
                        </div>
                    </div>
                    <div class="text-left flex-grow">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">Brand Identity</h3>
                        <p class="text-gray-700 font-reenie text-2xl font-bold">
                            Because your brand is more than just a logo.
                            I shape visual identities that speak your story — from color palettes to type, tone, and everything in between.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-[#FFF176] rounded-[12px] p-6 min-h-[320px] flex flex-col sticky-note sticky-note-yellow relative shadow-lg">
                <div class="flex flex-col h-full">
                    <img src="/blackpin.png" alt="Pin" class="pin-image" />
                    <div class="logo-container relative mb-4">
                        <div class="w-14 h-14 bg-black flex items-center justify-center overflow-hidden relative z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" width="24" height="24" fill="#ffffff"><path d="M64 96c0-35.3 28.7-64 64-64l384 0c35.3 0 64 28.7 64 64l0 256-64 0 0-256L128 96l0 256-64 0L64 96zM0 403.2C0 392.6 8.6 384 19.2 384l601.6 0c10.6 0 19.2 8.6 19.2 19.2c0 42.4-34.4 76.8-76.8 76.8L76.8 480C34.4 480 0 445.6 0 403.2zM281 209l-31 31 31 31c9.4 9.4 9.4 24.6 0 33.9s-24.6 9.4-33.9 0l-48-48c-9.4-9.4-9.4-24.6 0-33.9l48-48c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9zM393 175l48 48c9.4 9.4 9.4 24.6 0 33.9l-48 48c-9.4 9.4-24.6 9.4-33.9 0s-9.4-24.6 0-33.9l31-31-31-31c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0z"/></svg>
                        </div>
                    </div>
                    <div class="text-left flex-grow">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2">Web App Design</h3>
                        <p class="text-gray-700 text-md font-reenie text-2xl font-bold">
                            Designing web experiences people actually enjoy.
                            I combine UI precision with UX insight to build web app designs that are functional, responsive, and user-focused.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .sticky-note {
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        position: relative;
        transform: rotate(0deg);
        transition: all 0.3s ease;
    }
    
    .sticky-note::after {
        content: '';
        position: absolute;
        bottom: 0;
        right: 0;
        width: 30px;
        height: 30px;
        box-shadow: -2px -2px 5px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        border-bottom-right-radius: 12px;
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }
    
    .sticky-note:hover {
        transform: scale(1.03) rotate(-1deg);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }
    
    .sticky-note:hover::after {
        width: 35px;
        height: 35px;
    }

    /* Color-specific folded corners */
    .sticky-note-orange::after {
        background: linear-gradient(135deg, #FF9E80 0%, #FF9E80 50%, #E57373 50%, #FF8A65 60%, #D84315 100%);
    }

    .sticky-note-blue::after {
        background: linear-gradient(135deg, #80D8FF 0%, #80D8FF 50%, #64B5F6 50%, #29B6F6 60%, #0288D1 100%);
    }

    .sticky-note-purple::after {
        background: linear-gradient(135deg, #B388FF 0%, #B388FF 50%, #9575CD 50%, #7E57C2 60%, #5E35B1 100%);
    }

    .sticky-note-teal::after {
        background: linear-gradient(135deg, #84FFFF 0%, #84FFFF 50%, #4DD0E1 50%, #26C6DA 60%, #00ACC1 100%);
    }

    .sticky-note-green::after {
        background: linear-gradient(135deg, #B9F6CA 0%, #B9F6CA 50%, #81C784 50%, #66BB6A 60%, #43A047 100%);
    }

    .sticky-note-orange-light::after {
        background: linear-gradient(135deg, #FFCC80 0%, #FFCC80 50%, #FFB74D 50%, #FFA726 60%, #FB8C00 100%);
    }

    .sticky-note-pink::after {
        background: linear-gradient(135deg, #EA80FC 0%, #EA80FC 50%, #BA68C8 50%, #AB47BC 60%, #8E24AA 100%);
    }

    .sticky-note-yellow::after {
        background: linear-gradient(135deg, #FFF176 0%, #FFF176 50%, #E0D264 50%, #F5E082 60%, #DBC742 100%);
    }

    /* Add subtle rotation variety */
    .sticky-note:nth-child(odd) {
        transform: rotate(1deg);
    }
    
    .sticky-note:nth-child(even) {
        transform: rotate(-1deg);
    }
    
    .sticky-note:nth-child(3n) {
        transform: rotate(0deg);
    }

    .logo-container {
        position: relative;
        width: fit-content;
    }
    
    .pin-image {
        position: absolute;
        width: 40px;
        height: auto;
        top: -15px;
        left: 85%;
        transform: translateX(-50%);
        z-index: 20;
        filter: drop-shadow(0px 2px 2px rgba(0, 0, 0, 0.2));
    }
    
    .sticky-note:nth-child(odd) .pin-image {
        transform: translateX(-45%) rotate(5deg);
    }
    
    .sticky-note:nth-child(3n) .pin-image {
        transform: translateX(-55%) rotate(-5deg);
    }
    
    .sticky-note:nth-child(4n) .pin-image {
        transform: translateX(-50%) rotate(0deg);
    }

    /* Back button hover effect */
    .back-button {
        position: relative;
        overflow: hidden;
    }
</style>